+/* Checked clone for the bounded KRKR recording transaction. */
+plutovg_path_t* plutovg_path_clone_checked(const plutovg_path_t* path)
+{
+    if(!path || path->elements.size < 0 || sizeof(plutovg_path_t) > 256)
+        return NULL;
+    size_t count = (size_t)path->elements.size;
+    if(count > SIZE_MAX / sizeof(plutovg_path_element_t)) return NULL;
+    plutovg_path_t* clone = malloc(sizeof(plutovg_path_t));
+    if(!clone) return NULL;
+    *clone = *path;
+    plutovg_init_reference(clone);
+    clone->elements.data = count ? malloc(count * sizeof(plutovg_path_element_t)) : NULL;
+    if(count && !clone->elements.data) { free(clone); return NULL; }
+    clone->elements.capacity = clone->elements.size;
+    if(count) memcpy(clone->elements.data, path->elements.data, count * sizeof(plutovg_path_element_t));
+    return clone;
