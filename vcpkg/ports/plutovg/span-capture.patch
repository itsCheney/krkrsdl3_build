+/* Deep-copy the logical clip/state; a targetless surface is metadata only. */
+static bool span_copy_state(plutovg_state_t* target, const plutovg_state_t* source)
+{
+    *target = *source;
+    target->next = NULL;
+    target->paint = plutovg_paint_reference(source->paint);
+    target->font_face = plutovg_font_face_reference(source->font_face);
+    target->stroke.dash.array.data = NULL;
+    target->stroke.dash.array.size = target->stroke.dash.array.capacity = 0;
+    target->clip_spans.spans.data = NULL;
+    target->clip_spans.spans.size = target->clip_spans.spans.capacity = 0;
+    int n = source->stroke.dash.array.size;
+    if(n) {
+        target->stroke.dash.array.data = malloc((size_t)n * sizeof(float));
+        if(!target->stroke.dash.array.data) return false;
+        memcpy(target->stroke.dash.array.data, source->stroke.dash.array.data, (size_t)n * sizeof(float));
+        target->stroke.dash.array.size = target->stroke.dash.array.capacity = n;
+    }
+    n = source->clip_spans.spans.size;
+    if(n) {
+        target->clip_spans.spans.data = malloc((size_t)n * sizeof(plutovg_span_t));
+        if(!target->clip_spans.spans.data) return false;
+        memcpy(target->clip_spans.spans.data, source->clip_spans.spans.data, (size_t)n * sizeof(plutovg_span_t));
+        target->clip_spans.spans.size = target->clip_spans.spans.capacity = n;
+    }
+    return true;
+}
+plutovg_canvas_t* plutovg_canvas_clone_for_surface(const plutovg_canvas_t* source, plutovg_surface_t* surface)
+{
+    if(!source || !surface || source->surface->width != surface->width || source->surface->height != surface->height) return NULL;
+    plutovg_canvas_t* clone = plutovg_canvas_create(surface);
+    if(!clone) return NULL;
+    plutovg_state_destroy(clone->state); clone->state = NULL;
+    plutovg_state_t** tail = &clone->state;
+    for(const plutovg_state_t* s = source->state; s; s = s->next) {
+        plutovg_state_t* t = malloc(sizeof(plutovg_state_t));
+        if(!t) { plutovg_canvas_destroy(clone); return NULL; }
+        *tail = t;
+        if(!span_copy_state(t,s)) { plutovg_canvas_destroy(clone); return NULL; }
+        tail = &t->next;
+    }
+    clone->clip_rect = source->clip_rect;
+    return clone;
+}
+bool plutovg_canvas_rebind_surface(plutovg_canvas_t* canvas, plutovg_surface_t* surface)
+{
+    if(!canvas || !surface || canvas->span_capture || canvas->surface->width != surface->width || canvas->surface->height != surface->height) return false;
+    plutovg_surface_reference(surface);
+    plutovg_surface_destroy(canvas->surface);
+    canvas->surface = surface;
+    return true;
+}
+void plutovg_canvas_set_span_capture(plutovg_canvas_t* canvas, plutovg_span_capture_func_t callback, void* closure)
+{ canvas->span_capture = callback; canvas->span_closure = closure; canvas->span_failed = false; }
+bool plutovg_canvas_span_capture_failed(const plutovg_canvas_t* canvas) { return canvas->span_failed; }
